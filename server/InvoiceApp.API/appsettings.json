{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "Secret": "your_jwt_secret_minimum_32_characters_long_here",
    "RefreshSecret": "your_refresh_secret_minimum_32_chars_here",
    "AccessTokenExpiry": "15m",
    "RefreshTokenExpiry": "7d",
    "Issuer": "InvoiceApp",
    "Audience": "InvoiceAppUsers"
  },
  "Stripe": {
    "SecretKey": "sk_test_your_stripe_secret_key_here",
    "WebhookSecret": "whsec_your_webhook_secret_here",
    "Currency": "usd"
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your@gmail.com",
    "Password": "your_app_password",
    "FromName": "InvoiceApp"
  },
  "ClientUrl": "http://localhost:5173",
  "Hangfire": {
    "DashboardPath": "/hangfire"
  },
  "RateLimit": {
    "AuthEndpoints": {
      "Limit": 10,
      "Period": "15m"
    },
    "ApiEndpoints": {
      "Limit": 100,
      "Period": "15m"
    }
  }
}
